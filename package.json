{
  "name": "@compootor/effective-jev",
  "version": "0.0.1",
  "description": "Effect v4 SDK for the TypeSafe Jev API",
  "license": "MIT",
  "author": "evinism",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "check:version": "node scripts/check-version.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "node scripts/release.mjs check --publish",
    "demo": "tsx examples/demo.ts",
    "check": "npm run lint && npm run typecheck && npm run check:version && npm run test:release && npm run test:coverage && npm run build && npm run test:dist && npm run check:package",
    "docs": "npm ci --prefix docs --ignore-scripts --no-audit --no-fund && npm run --prefix docs build",
    "prepack": "npm run build",
    "test:release": "node --test test/release/*.test.mjs",
    "check:jsr": "jsr publish --dry-run --allow-dirty --allow-slow-types && node --test test/release/jsr-package.integration.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "release:pack": "npm run check && npm run check:jsr && node scripts/release.mjs pack && node scripts/test-tarball.mjs",
    "release:publish:npm": "node scripts/publish-npm.mjs",
    "release:publish:jsr": "node scripts/publish-jsr.mjs",
    "release:verify": "node scripts/publish-npm.mjs --verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/parser": "7.29.8",
    "@biomejs/biome": "^2.5.11",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "effect": "4.0.0-rc.112",
    "git-cliff": "2.13.1",
    "jsr": "^0.14.3",
    "publint": "^0.3.24",
    "semver": "7.8.5",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoopid-computers/effective-jev.git"
  },
  "homepage": "https://github.com/stoopid-computers/effective-jev#readme",
  "bugs": {
    "url": "https://github.com/stoopid-computers/effective-jev/issues"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
